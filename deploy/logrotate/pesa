# Log di Pesa sul VPS Milano — retention 90 giorni (informativa privacy §6).
# Installare in /etc/logrotate.d/pesa.
#
# /var/log/pesa/backend.log  — una riga JSON per richiesta (path, status,
#                              duration_ms, pseudonimo utente) + errori;
#                              scritto dal container via PESA_LOG_FILE.
# Gli access log di Caddy (/var/log/caddy/pesadia-access.log) ruotano da soli
# (roll_keep_for nel Caddyfile).

/var/log/pesa/*.log {
    daily
    rotate 90
    maxage 90
    missingok
    notifempty
    compress
    delaycompress
    # il backend tiene il file aperto in O_APPEND: copia + troncamento.
    copytruncate
    su root root
}
